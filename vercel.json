{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/artigo/:slug",
      "destination": "/api/artigo?slug=:slug"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/categoria/:category",
      "destination": "/index.html"
    },
    {
      "source": "/busca",
      "destination": "/index.html"
    },
    {
      "source": "/enviar-noticia",
      "destination": "/index.html"
    },
    {
      "source": "/eventos",
      "destination": "/index.html"
    },
    {
      "source": "/sobre-nos",
      "destination": "/index.html"
    },
    {
      "source": "/contato",
      "destination": "/index.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/index.html"
    },
    {
      "source": "/termos-de-uso",
      "destination": "/index.html"
    },
    {
      "source": "/videos",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/create-admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ],
  "buildCommand": "npm run build && cp dist/index.html dist/404.html",
  "outputDirectory": "dist",
  "framework": "vite"
}
